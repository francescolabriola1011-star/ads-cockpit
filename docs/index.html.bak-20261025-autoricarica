<!doctype html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title>ADS Cockpit</title>
<style>
:root{
  --surface:#1a1a19; --plane:#0d0d0d; --card:#212120; --line:#33322f;
  --ink:#ffffff; --ink2:#c3c2b7; --muted:#898781;
  --good:#0ca30c; --warn:#fab219; --serious:#ec835a; --crit:#d03b3b;
  --accent:#d4af37;
}
@media (prefers-color-scheme: light){
  :root{ --surface:#fcfcfb; --plane:#f9f9f7; --card:#ffffff; --line:#e4e3df;
         --ink:#0b0b0b; --ink2:#52514e; --muted:#898781; --accent:#8a6d0b; }
}
*{box-sizing:border-box}
body{margin:0;background:var(--plane);color:var(--ink);
  font:15px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  -webkit-font-smoothing:antialiased}
.wrap{max-width:1180px;margin:0 auto;padding:28px 20px 80px}
a{color:var(--accent)}
h1{font-size:26px;margin:0 0 4px;letter-spacing:-.02em}
h2{font-size:15px;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);
   margin:38px 0 12px;font-weight:600}
.sub{color:var(--muted);font-size:13px;margin:0}
.mono{font-variant-numeric:tabular-nums}

/* regole */
.rules{display:flex;flex-wrap:wrap;gap:8px;margin:16px 0 0}
.rule{background:var(--card);border:1px solid var(--line);border-radius:999px;
  padding:5px 12px;font-size:12.5px;color:var(--ink2)}
.rule b{color:var(--ink)}

/* stat tiles */
.tiles{display:grid;gap:12px;margin-top:14px;
  grid-template-columns:repeat(auto-fit,minmax(168px,1fr))}
.tile{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:14px 16px}
.tile .lab{font-size:11.5px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted)}
.tile .val{font-size:27px;font-weight:650;margin-top:5px;letter-spacing:-.02em}
.tile .note{font-size:12px;color:var(--muted);margin-top:3px}
.tile.hero{border-color:var(--crit)}
.tile.hero .val{color:var(--crit)}
.tile.act{border-color:var(--warn)}
.tile.act .val{color:var(--warn)}

/* azioni */
.act-row{display:grid;grid-template-columns:22px 88px 1fr auto;gap:14px;align-items:center;
  background:var(--card);border:1px solid var(--line);border-left:3px solid var(--crit);
  border-radius:10px;padding:12px 16px;margin-bottom:8px}
.act-row .who{font-weight:650;font-size:13px;color:var(--accent)}
.act-row .what{font-size:14px}
.act-row .why{font-size:12.5px;color:var(--muted);margin-top:2px}
.pos{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin:0 0 12px;font-size:12px}
.pos .pl{color:var(--muted);margin-right:2px}
.pos span.p{border:1px solid var(--line);border-radius:999px;padding:3px 9px;white-space:nowrap}
.pos span.p.kill{border-color:var(--crit);color:var(--crit);font-weight:600}
.act-row .tick input{width:18px;height:18px;cursor:pointer;accent-color:var(--good)}
.act-row.done{opacity:.5;border-left-color:var(--good)}
.act-row.done .what{text-decoration:line-through}
.act-row .burn{text-align:right;font-size:13px;color:var(--crit);font-weight:600;white-space:nowrap}
.act-row.near{grid-template-columns:88px 1fr auto;border-left-color:var(--warn)}
.act-row.near .burn{color:var(--warn)}

/* chip stato */
.chip{display:inline-flex;align-items:center;gap:5px;font-size:11.5px;font-weight:650;
  padding:3px 8px;border-radius:6px;white-space:nowrap;border:1px solid}
.chip .dot{width:7px;height:7px;border-radius:50%}
.c-kill{color:var(--crit);border-color:var(--crit)} .c-kill .dot{background:var(--crit)}
.c-watch{color:var(--warn);border-color:var(--warn)} .c-watch .dot{background:var(--warn)}
.c-winner{color:var(--good);border-color:var(--good)} .c-winner .dot{background:var(--good)}
.c-ok{color:var(--ink2);border-color:var(--line)} .c-ok .dot{background:var(--ink2)}
.c-early{color:var(--muted);border-color:var(--line)} .c-early .dot{background:var(--muted)}

/* clienti */
.client{background:var(--card);border:1px solid var(--line);border-radius:12px;
  margin-bottom:10px;overflow:hidden}
.chead{display:grid;grid-template-columns:110px repeat(5,minmax(66px,1fr)) 150px 24px;
  gap:12px;align-items:center;padding:14px 16px;cursor:pointer;user-select:none}
.chead:hover{background:rgba(212,175,55,.05)}
.chead .alias{font-weight:700;color:var(--accent);letter-spacing:.02em}
.k{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em}
.v{font-size:16px;font-weight:600;margin-top:2px}
.bar{height:7px;border-radius:4px;background:rgba(137,135,129,.22);overflow:hidden;margin-top:7px}
.bar > i{display:block;height:100%;border-radius:4px;background:var(--crit)}
.caret{color:var(--muted);transition:transform .15s}
.client.open .caret{transform:rotate(90deg)}
.cbody{display:none;border-top:1px solid var(--line);padding:4px 0 8px}
.client.open .cbody{display:block}

table{width:100%;border-collapse:collapse;font-size:13.5px}
th{font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);
   text-align:right;padding:10px 12px;font-weight:600;border-bottom:1px solid var(--line)}
th:first-child,td:first-child{text-align:left}
td{padding:10px 12px;border-bottom:1px solid var(--line);text-align:right;vertical-align:top}
tr:last-child td{border-bottom:none}
.cname{max-width:340px}
.cname .n{font-weight:550}
.cname .r{font-size:12px;color:var(--muted);margin-top:2px}
.flag{font-size:12px;color:var(--serious);margin-top:3px}
.off{opacity:.5}
tr.camp td{background:rgba(127,127,127,.07)}
tr.ad .cname .n{font-weight:450;padding-left:10px}
.flag.riprova{background:#fff4d6;border-left:3px solid #e0a800;color:#7a5600;font-weight:600;padding-left:6px}
.tag-off{font-size:10.5px;color:var(--muted);border:1px solid var(--line);
  border-radius:4px;padding:1px 5px;margin-left:6px}
.up{color:var(--crit)} .down{color:var(--good)}

/* filtri */
.filters{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin:14px 0 0}
select,button.tgl{background:var(--card);color:var(--ink);border:1px solid var(--line);
  border-radius:8px;padding:7px 11px;font:inherit;font-size:13px;cursor:pointer}
button.tgl[aria-pressed="true"]{border-color:var(--accent);color:var(--accent)}
.empty{color:var(--muted);padding:18px;text-align:center;font-size:13.5px}
.topbar{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;flex-wrap:wrap}
.fermi{display:flex;flex-wrap:wrap;gap:8px;margin-top:6px}
.fermo{background:var(--card);border:1px dashed var(--line);border-radius:8px;
  padding:7px 12px;font-size:13px;color:var(--ink2)}
.fermo b{color:var(--accent)}
.nuovo{background:var(--card);border:1px solid var(--good);border-left:3px solid var(--good);
  border-radius:10px;padding:11px 16px;margin-top:14px;font-size:13.5px}
.nuovo b{color:var(--good)}
.h2note{font-size:12px;text-transform:none;letter-spacing:0;font-weight:400;margin-left:6px}
.h3{font-size:13px;color:var(--muted);font-weight:600;margin:18px 0 8px}
details.regole{margin-top:12px}
details.regole summary{cursor:pointer;color:var(--muted);font-size:13px}
/* griglia clienti */
.griglia{display:grid;gap:12px;grid-template-columns:repeat(auto-fill,minmax(270px,1fr))}
.cc{all:unset;box-sizing:border-box;cursor:pointer;display:block;background:var(--card);
  border:1px solid var(--line);border-top:4px solid var(--good);border-radius:12px;padding:13px 15px}
.cc:hover,.cc:focus-visible{border-color:var(--accent);outline:none}
.cc.l1{border-top-color:var(--warn)} .cc.l2{border-top-color:var(--crit)}
.cc-top{display:flex;align-items:center;gap:8px}
.cc-top b{font-size:15px;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.cc-st{font-size:10.5px;font-weight:700;letter-spacing:.05em;padding:2px 7px;border-radius:5px;
  color:var(--good);border:1px solid var(--good);white-space:nowrap}
.cc.l1 .cc-st{color:var(--warn);border-color:var(--warn)} .cc.l2 .cc-st{color:var(--crit);border-color:var(--crit)}
.cc-big{display:flex;align-items:baseline;gap:8px;flex-wrap:wrap;margin-top:9px}
.cc-big .v{font-size:25px;font-weight:700;margin:0;letter-spacing:-.02em}
.cc-big .tr{font-size:12.5px;font-weight:600}
.cc-nums{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-top:9px}
.cc-nums .v{font-size:15px}
.cc-nums .k{white-space:nowrap}
.cc svg{display:block;width:100%;height:46px;margin-top:10px}
.cc-why{font-size:12px;color:var(--ink2);margin-top:8px;line-height:1.4}
/* galleria statiche */
.galleria{display:grid;gap:14px;grid-template-columns:repeat(auto-fill,minmax(210px,1fr))}
.st{background:var(--card);border:1px solid var(--line);border-radius:12px;overflow:hidden;display:flex;flex-direction:column}
.st.cli{border-color:var(--good)}
.st .img{aspect-ratio:4/5;background:rgba(127,127,127,.12);display:flex;align-items:center;justify-content:center;
  text-align:center;padding:14px;font-size:13px;color:var(--muted)}
.st .img img{width:100%;height:100%;object-fit:cover;display:block}
.st .img:has(img){padding:0}
.st .tx{padding:11px 13px 13px}
.st .tx .n{font-weight:650;font-size:13.5px;line-height:1.3}
.st .tx .c{font-size:12px;color:var(--accent);font-weight:650;margin-bottom:3px}
.st .res{display:flex;gap:14px;margin-top:8px}
.st .res .v{font-size:20px}
.st .nota{font-size:11.5px;color:var(--muted);margin-top:8px;line-height:1.4}
footer{margin-top:44px;color:var(--muted);font-size:12px;border-top:1px solid var(--line);padding-top:14px}
@media(max-width:820px){
  .wrap{padding:20px 16px 60px}
  .griglia{grid-template-columns:1fr}
  .galleria{grid-template-columns:repeat(2,1fr);gap:10px}
  .chead{grid-template-columns:1fr 1fr;gap:10px}
  .chead .spark{grid-column:1/-1}
  .act-row{grid-template-columns:1fr;gap:6px}
  .act-row .burn{text-align:left}
  table{font-size:12.5px} td,th{padding:8px}
}
</style>
</head>
<body>
<div class="wrap">
  <div class="topbar">
    <div>
      <h1 id="titolo">ADS Cockpit</h1>
      <p class="sub" id="meta">caricamento…</p>
    </div>
    <button class="tgl" id="unlock">Mostra nomi veri</button>
  </div>
  <div id="ruolo"></div>
  <div id="nuovi"></div>

  <div class="filters" id="scopebar">
    <select id="fCliente"><option value="">Tutti i clienti</option></select>
    <span class="sub" id="scopeNote"></span>
  </div>

  <h2>Da fare oggi <span id="nact" style="color:var(--crit)"></span></h2>
  <div id="azioni"></div>
  <h3 class="h3">Da monitorare <span id="nmon" style="color:var(--warn,#d4a537)"></span></h3>
  <div id="monitorare"></div>
  <h3 class="h3">Vicini alla soglia <span id="nnear" style="color:var(--warn,#d4a537)"></span></h3>
  <p class="sub" id="nearNote" style="margin:-4px 0 8px"></p>
  <div id="vicini"></div>

  <h2>Come va ogni cliente <span class="h2note">dal peggiore al migliore · clic per il dettaglio</span></h2>
  <div class="griglia" id="griglia"></div>
  <p class="sub" id="legenda" style="margin-top:10px"></p>

  <h2>Statiche che portano clienti e appuntamenti</h2>
  <div id="statiche"></div>

  <h2 id="h-quadro">Il quadro del periodo</h2>
  <div class="tiles" id="tiles"></div>
  <details class="regole"><summary>Le regole di stacco</summary>
    <div class="rules" id="rules"></div></details>

  <h2>Dove riallocare</h2>
  <div id="realloc"></div>

  <h2>Dettaglio per cliente <span id="ntitle" style="color:var(--muted);font-weight:400"></span></h2>
  <div class="filters">
    <select id="fStato">
      <option value="">Tutti gli stati</option>
      <option value="kill">Solo da staccare</option>
      <option value="watch">Solo sorvegliate</option>
      <option value="winner">Solo vincenti</option>
    </select>
    <button class="tgl" id="fAttive" aria-pressed="false">Solo creative ancora accese</button>
    <button class="tgl" id="fExp" aria-pressed="false">Apri tutti i clienti</button>
  </div>
  <div id="clienti"></div>
  <div class="fermi" id="fermi"></div>

  <!-- ALLARMI CONFIGURAZIONE — compare solo dove esiste allarmi.json. Sta in ALTO
       perche' e' l'unica cosa che va guardata prima dei numeri: se una campagna e'
       nata male, i numeri sotto stanno misurando una cosa rotta.
       Dati da motore/collaudo_ads.py (Meta + Drive). -->
  <section id="allarmi" hidden></section>
  <style>#allarmi .grave{color:var(--crit);font-weight:700}
  #allarmi .medio{color:var(--accent);font-weight:650}
  #allarmi .lieve{color:var(--muted)}</style>
  <!-- COSTI CHE SCAPPANO — compare solo dove esiste costi.json (la dashboard di
       casa AEA). Stessa domanda delle ads, sull'altro lato: dove escono soldi
       che non dovrebbero. Dati da motore/costi_che_scappano.py (Zoho Books). -->
  <section id="costi" hidden></section>
  <style>#costi .num{text-align:right;font-variant-numeric:tabular-nums}</style>

  <footer id="foot"></footer>
</div>

<script>
const eur = n => "€" + (n ?? 0).toLocaleString("it-IT",{minimumFractionDigits:2,maximumFractionDigits:2});
const eur0 = n => "€" + Math.round(n ?? 0).toLocaleString("it-IT");
const int = n => Math.round(n ?? 0).toLocaleString("it-IT");
const esc = s => String(s ?? "").replace(/[&<>"]/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));

const LABEL = {kill:"STACCA", watch:"SORVEGLIA", winner:"VINCENTE", ok:"OK", early:"PRESTO"};
const chip = s => `<span class="chip c-${s}"><span class="dot"></span>${LABEL[s]||s}</span>`;

let DATA = null, NAMES = null, THUMBS = null, THUMBS_CHIARO = null;
/* ?cliente=SIGLA apre la pagina già sul singolo account: è il link
   che si manda al cliente perché veda solo il suo. */
let state = {cliente: new URLSearchParams(location.search).get("cliente") || "",
             stato:"", soloAttive:false, expand:false};

/* Nome cliente e campagna: sigla finche' non si sbloccano i nomi veri. */
/* Con anonymize:false il nome vero arriva gia' nel dato; altrimenti si
   parte dalla sigla e lo si sblocca con la passphrase. */
const gg = iso => { const p = String(iso||"").split("-"); return p.length===3 ? p[2]+"/"+p[1] : String(iso||""); };
const nomeCli = a => (NAMES && NAMES.clienti[a.alias]) || a.nome_breve || a.nome_reale || a.alias;
const nomeCamp = k => (NAMES && NAMES.campagne[k.id]) || k.name;

/* ---------- sblocco nomi veri (AES-GCM, chiave da passphrase) ---------- */
const b64 = s => Uint8Array.from(atob(s), c => c.charCodeAt(0));

async function decryptFile(file, pass){
  const enc = await (await fetch(file + "?" + Date.now())).json();
  const base = await crypto.subtle.importKey("raw", new TextEncoder().encode(pass),
    "PBKDF2", false, ["deriveKey"]);
  const key = await crypto.subtle.deriveKey(
    {name:"PBKDF2", salt:b64(enc.salt), iterations:enc.iter, hash:"SHA-256"},
    base, {name:"AES-GCM", length:256}, false, ["decrypt"]);
  const plain = await crypto.subtle.decrypt({name:"AES-GCM", iv:b64(enc.nonce)}, key, b64(enc.ct));
  return JSON.parse(new TextDecoder().decode(plain));
}

async function unlock(pass, silent){
  const btn = document.getElementById("unlock");
  try {
    NAMES = await decryptFile("names.enc", pass);
    /* miniature delle statiche: stessa passphrase, possono mostrare volto o nome */
    try { THUMBS = await decryptFile("thumbs.enc", pass); } catch(e) {}
    sessionStorage.setItem("adscockpit_pw", pass);
    btn.textContent = "Nascondi nomi veri";
    btn.setAttribute("aria-pressed","true");
    render();
  } catch(e){
    NAMES = null;
    sessionStorage.removeItem("adscockpit_pw");
    if (!silent) alert("Passphrase sbagliata.");
  }
}

/* ---------- caricamento ---------- */
fetch("data.json?" + Date.now())
  .then(r => r.json())
  .then(d => {
    DATA = d;
    document.getElementById("ruolo").innerHTML = d.ruolo_html || "";
    render();
    document.getElementById("unlock").style.display = d.nomi_sbloccabili ? "" : "none";
    const saved = sessionStorage.getItem("adscockpit_pw");
    if (saved && d.nomi_sbloccabili) unlock(saved, true);
  })
  .catch(e => document.getElementById("meta").textContent = "Impossibile leggere data.json: " + e);

fetch("thumbs.json?" + Date.now()).then(r => r.ok ? r.json() : null).then(t => {
  if (!t) return;
  THUMBS_CHIARO = t; THUMBS = THUMBS || t;
  if (DATA) renderStatiche(scope());
}).catch(() => {});

/* Il perimetro di TUTTA la pagina: tutti i clienti, o quello selezionato. */
let CVRMIN = 4;
const R2 = () => (DATA && DATA.regole) || {};
/* CVR click -> lead: quanti dei click che abbiamo pagato diventano un contatto vero.
   Sotto la soglia il collo e' il MODULO (o la landing), non le ads. */
const cvrCli  = c => (c.link_clicks ? c.leads / c.link_clicks * 100 : null);
const cvrCamp = k => (k.link_clicks ? k.leads / k.link_clicks * 100 : null);
/* letture sulle sole creative accese (campo "vivo" del motore) */
const vCpl  = c => (c.vivo ? c.vivo.cpl : null);
const vLead = c => (c.vivo ? c.vivo.leads : 0);
const vCvr  = c => (c.vivo ? c.vivo.cvr : null);

function scope(){
  if (!state.cliente) return DATA.clienti;
  return DATA.clienti.filter(c => c.alias === state.cliente);
}

/* I totali vengono ricalcolati sul perimetro, non letti dal file:
   così selezionando un cliente ogni numero in pagina parla solo di lui. */
function totali(sel){
  const spesa = sel.reduce((s,c)=>s+c.spend,0);
  const lead  = sel.reduce((s,c)=>s+c.leads,0);
  const spr   = sel.reduce((s,c)=>s+c.sprecato,0);
  const linkClicks = sel.reduce((s,c)=>s+(c.link_clicks||0),0);
  const g = DATA.periodo.giorni || 1;
  /* CPL e CVR si leggono sulle CREATIVE ACCESE (c.vivo), non sulla media
     di campagna: con una campagna sola sempre accesa la media include le
     creative gia' staccate e racconta un CPL che non esiste piu' (16/9/2026). */
  const vivi = sel.filter(c => c.vivo);
  const vs = vivi.reduce((s,c)=>s+c.vivo.spend,0);
  const vl = vivi.reduce((s,c)=>s+c.vivo.leads,0);
  const vc = vivi.reduce((s,c)=>s+(c.vivo.link_clicks||0),0);
  const ncr = vivi.reduce((s,c)=>s+(c.vivo.n_creative||0),0);
  return {
    spesa, lead, sprecato: spr,
    cpl: vl ? vs/vl : null,
    cpl_storico: lead ? spesa/lead : null,
    creative_accese: ncr,
    linkClicks,
    cvr: vc ? vl/vc*100 : null,
    quota: spesa ? spr/spesa*100 : 0,
    al_mese: spr/g*30,
    brucia_oggi: sel.reduce((s,c)=>s+c.brucia_oggi,0),
    da_staccare: sel.reduce((s,c)=>s+c.n_kill_ancora_accese,0),
    /* Lead mancati = quanti lead avrebbe dato TUTTO il budget girando al CPL
       target, meno quelli arrivati davvero. Non e' il budget parcheggiato sui
       perdenti (quello sta nella tabella di riallocazione): e' il divario col
       target, e per questo e' un numero grosso. */
    lead_mancati: 0,
    campagne: sel.reduce((s,c)=>s+c.n_campagne,0)
  };
}

const tile = (lab,val,note,cls="") =>
  `<div class="tile ${cls}"><div class="lab">${lab}</div>
   <div class="val mono">${val}</div><div class="note">${note||""}</div></div>`;

function render(){
  const d = DATA, R = d.regole, sel = scope(), t = totali(sel);
  CVRMIN = R.cvr_floor_pct || 4;
  const CPLT = R.cpl_target_eur || 15;
  t.lead_attesi = CPLT ? Math.floor(t.spesa / CPLT) : 0;
  t.lead_mancati = Math.max(0, t.lead_attesi - t.lead);
  const uno = sel.length === 1;

  document.title = d.titolo || "ADS Cockpit";
  document.getElementById("titolo").textContent =
    (state.cliente && uno) ? nomeCli(sel[0]) : (d.titolo || "ADS Cockpit");

  const gen = new Date(d.generato);
  document.getElementById("meta").innerHTML =
    `Periodo <b>${d.periodo.da}</b> → <b>${d.periodo.a}</b> (${d.periodo.giorni} giorni) ·
     ${sel.length} ${sel.length === 1 ? "account" : "account"} · ${int(t.campagne)} campagne ·
     aggiornato ${gen.toLocaleString("it-IT",{dateStyle:"short",timeStyle:"short"})}`;

  document.getElementById("rules").innerHTML = [
    `<b>0 lead</b> sopra ${eur0(R.spend_kill_zero_lead_eur || R.spend_warn_eur)} di spesa → si stacca`,
