/* ---------- azioni di oggi, spuntabili ----------
   Le spunte stanno nel ponte condiviso della checklist CSM (foglio Google via
   Apps Script), cosi' chi spunta da un telefono lo vede anche l'altro.
   Chiave: ckcsm:ads|<sigla>|ad|<id inserzione>:<giorno della spunta>.
   Spuntata oggi resta barrata fino a domani; dal giorno dopo non esce piu'.
   Il ponte toglie da solo le spunte oltre 21 giorni: se una creativa e' ancora
   accesa e fuori regola dopo tre settimane, torna fuori, ed e' giusto cosi'. */
const SYNC = "https://script.google.com/macros/s/AKfycbyYBeMPQ6wKtKeScl-XAK5dgqb7TOlUZTsE3u2ZyXZwMbcE7qQnV3oQly9dDEzcrDcC/exec";
const OGGI = new Date().toLocaleDateString("sv-SE", {timeZone:"Europe/Rome"});
let SPUNTE = {};
try { SPUNTE = JSON.parse(localStorage.getItem("adscockpit_spunte") || "{}"); } catch(e) {}
const salvaLocale = () => { try { localStorage.setItem("adscockpit_spunte", JSON.stringify(SPUNTE)); } catch(e) {} };

function leggiSpunte(){
  return fetch(SYNC + "?t=" + Date.now()).then(r => r.json()).then(j => {
    const nuove = {};
    Object.keys((j && j.stato) || {}).forEach(k => {
      const m = k.match(/^ckcsm:ads\|(.+):(\d{4}-\d{2}-\d{2})$/);
      if (m && (!nuove[m[1]] || m[2] > nuove[m[1]])) nuove[m[1]] = m[2];
    });
    SPUNTE = nuove; salvaLocale();
    if (DATA) renderAzioni(scope());
  }).catch(() => {});
}

function spunta(id, on){
  const set = {};
  if (on) { set["ckcsm:ads|" + id + ":" + OGGI] = 1; SPUNTE[id] = OGGI; }
  else if (SPUNTE[id]) { set["ckcsm:ads|" + id + ":" + SPUNTE[id]] = 0; delete SPUNTE[id]; }
  salvaLocale();
  renderAzioni(scope());
  fetch(SYNC, {method:"POST", headers:{"Content-Type":"text/plain;charset=utf-8"},
    body: JSON.stringify({set})}).catch(() => {});
}

/* 23/10/2026: voci "da monitorare" scritte in monitorare.json. Giornaliera =
   torna ogni mattina, la spunta vale per oggi. Una volta = spuntata sparisce. */
function renderMonitorare(sel){
  const host = document.getElementById("monitorare");
  if (!host) return;
  const al = new Set(sel.map(c => c.alias));
  const cli = {}; ((DATA && DATA.clienti) || []).concat((DATA && DATA.fermi) || []).forEach(c => cli[c.alias] = c);
  const voci = ((DATA && DATA.monitorare) || []).filter(v => al.has(v.alias))
    .filter(v => !(v.tipo === "una_volta" && SPUNTE[v.id] && SPUNTE[v.id] < OGGI));
  const fatta = v => v.tipo === "una_volta" ? !!SPUNTE[v.id] : SPUNTE[v.id] === OGGI;
  voci.sort((a,b) => (fatta(a) ? 1 : 0) - (fatta(b) ? 1 : 0));
  const daFare = voci.filter(v => !fatta(v)).length;
  document.getElementById("nmon").textContent = daFare ? `(${daFare})` : "";
  if (!voci.length) { host.innerHTML = `<p class="sub">Niente da monitorare.</p>`; return; }
  host.innerHTML = voci.map(v => `
    <div class="act-row${fatta(v) ? " done" : ""}">
      <label class="tick" title="${v.tipo === "una_volta" ? "Spunta quando e' controllato: da domani non esce piu'" : "Spunta quando l'hai guardato oggi: domani torna"}">
        <input type="checkbox" data-az="${esc(v.id)}" ${fatta(v) ? "checked" : ""}></label>
      <div class="who">${esc(cli[v.alias] ? nomeCli(cli[v.alias]) : v.alias)}</div>
      <div><div class="what">${esc(v.cosa)}</div>
        <div class="why">${esc(v.perche)}</div></div>
      <div class="burn">${v.tipo === "una_volta" ? "una volta" : "ogni giorno"}<br>
        <span style="color:var(--muted);font-weight:400">dal ${esc(v.dal)}</span></div>
    </div>`).join("");
  host.querySelectorAll("input[data-az]").forEach(cb =>
    cb.addEventListener("change", () => spunta(cb.dataset.az, cb.checked)));
}

function renderVicini(sel){
  const host = document.getElementById("vicini");
  if (!host) return;
  const limite = Number((DATA && DATA.regole && DATA.regole.placement_max_eur) || 45);
  const minimo = limite * 2 / 3;
  const voci = [];
  sel.forEach(c => ((c.posizionamenti || {}).voci || []).forEach(p => {
    if (p.escluso || p.da_staccare) return;
    const metro = p.leads ? Number(p.cpl || 0) : Number(p.spend || 0);
    if (metro >= minimo && metro < limite) voci.push({cli:c, pos:p, metro});
  }));
  voci.sort((a,b) => b.metro - a.metro);
  document.getElementById("nnear").textContent = voci.length ? `(${voci.length})` : "";
  document.getElementById("nearNote").innerHTML =
    `Posizionamenti ancora abilitati fra <b>${eur(minimo)}</b> e <b>${eur(limite)}</b>. ` +
    `Con lead si guarda il CPL, senza lead si guarda la spesa.`;
  if (!voci.length) {
    host.innerHTML = `<p class="sub">Nessun posizionamento vicino alla soglia.</p>`;
    return;
  }
  host.innerHTML = voci.map(x => {
    const p = x.pos;
    const periodo = (x.cli.posizionamenti || {}).periodo || "durata massima";
    const valore = p.leads ? `CPL ${eur(p.cpl)}` : `${eur(p.spend)} spesi · 0 lead`;
    const distanza = p.leads ? "al limite CPL" : "al limite di spesa";
    return `<div class="act-row near">
      <div class="who">${esc(nomeCli(x.cli))}</div>
      <div><div class="what">${esc(p.posto || p.nome)}</div>
        <div class="why">${esc(p.adset || "")} · ${esc(periodo)} · ${int(p.leads)} lead</div></div>
      <div class="burn">${valore}<br>
        <span style="color:var(--muted);font-weight:400">mancano ${eur(limite - x.metro)} ${distanza}</span></div>
    </div>`;
  }).join("");
}

function renderAzioni(sel){
  renderMonitorare(sel);
  renderVicini(sel);
  const voci = [];
  sel.forEach(c => c.campagne.forEach(k => (k.ads || []).forEach(a => {
    if (a.status === "kill" && a.attiva) voci.push({
      id: c.alias + "|ad|" + a.id, cli:c, campagna:k, creativa:a, daily_budget:k.daily_budget || 0});
  })));
  voci.sort((a,b) => (b.daily_budget||0) - (a.daily_budget||0) || b.creativa.sprecato - a.creativa.sprecato);
  /* posizionamenti fuori regola ancora in spesa: UNA riga per account; se si
     aggiunge un posizionamento nuovo la chiave cambia e la riga torna fuori */
  /* 22/10/2026: la spunta vale per il SINGOLO posizionamento. Prima la chiave
     era l'insieme, e se ne entrava uno nuovo tornavano fuori anche quelli gia'
     esclusi (Dal Bosco, De Leonardis). Ora esce solo cio' che non e' stato spuntato. */
  const posFatti = {};
  Object.keys(SPUNTE).forEach(k => {
    const m = k.match(/^(.+)\|pos\|(.+)$/);
    if (m) m[2].split("+").forEach(n => {
      const kk = m[1] + "|" + n;
      if (!posFatti[kk] || SPUNTE[k] > posFatti[kk]) posFatti[kk] = SPUNTE[k];
    });
  });
  const vecchiePos = [];
  sel.forEach(c => {
    const v = ((c.posizionamenti || {}).voci || []).filter(p => p.da_staccare);
    const prima = v.filter(p => posFatti[c.alias + "|" + p.nome] && posFatti[c.alias + "|" + p.nome] < OGGI);
    const nuove = v.filter(p => !prima.includes(p));
    if (nuove.length) voci.push({id: c.alias + "|pos|" + nuove.map(p => p.nome).sort().join("+"), cli:c, pos:nuove});
    prima.forEach(p => vecchiePos.push({cli:c, pos:[p], giorno: posFatti[c.alias + "|" + p.nome]}));
  });
  const nascoste = voci.filter(x => SPUNTE[x.id] && SPUNTE[x.id] < OGGI).length + vecchiePos.length;
  const vive = voci.filter(x => !(SPUNTE[x.id] && SPUNTE[x.id] < OGGI));
  const daFare = vive.filter(x => !SPUNTE[x.id]).length;
  vive.sort((a,b) => (SPUNTE[a.id] ? 1 : 0) - (SPUNTE[b.id] ? 1 : 0));
  document.getElementById("nact").textContent = daFare ? `(${daFare})` : "";
  const box = x => `<label class="tick" title="Spunta quando e' fatto: da domani non esce piu'">
      <input type="checkbox" data-az="${esc(x.id)}" ${SPUNTE[x.id] ? "checked" : ""}></label>`;
  const riga = x => x.pos ? `
    <div class="act-row${SPUNTE[x.id] ? " done" : ""}">${box(x)}
      <div class="who">${esc(nomeCli(x.cli))}</div>
      <div><div class="what">Posizionamenti da escludere: ${x.pos.map(p => esc(p.nome)).join(", ")}</div>
        <div class="why">durata massima, per ad set attivo · ${x.pos.map(p => `${esc(p.nome)}: ${esc(p.reason)}`).join(" · ")}</div></div>
      <div class="burn">speso ${eur(x.pos.reduce((t,p) => t + p.spend, 0))} in totale<br>
        <span style="color:var(--muted);font-weight:400">${int(x.pos.reduce((t,p) => t + p.leads, 0))} lead in tutto</span></div>
    </div>` : `
    <div class="act-row${SPUNTE[x.id] ? " done" : ""}">${box(x)}
      <div class="who">${esc(nomeCli(x.cli))}</div>
      <div><div class="what">Creativa: ${esc(x.creativa.name)}</div>
        <div class="why">Campagna: ${esc(nomeCamp(x.campagna))} · ${esc(x.creativa.reason)}${
          x.creativa.flags.length ? " · " + esc(x.creativa.flags[0]) : ""}</div></div>
      <div class="burn">${x.daily_budget ? eur(x.daily_budget)+"/giorno" : "attiva"}<br>
        <span style="color:var(--muted);font-weight:400">già sprecati ${eur(x.creativa.sprecato)}</span></div>
    </div>`;
  /* 22/10/2026: controllo del mattino. Una lista vuota con i dati di ieri
     sembra "tutto pulito" e non lo e'. E le spuntate nascoste sono, per
     costruzione, creative ANCORA accese e fuori regola su Meta (nella lista
     entrano solo le attive): restano fuori dalla lista, ma si dicono. */
  const gen = DATA && DATA.generato ? new Date(DATA.generato) : null;
  const genGiorno = gen ? gen.toLocaleDateString("sv-SE", {timeZone:"Europe/Rome"}) : "";
  const genOra = gen ? gen.toLocaleString("it-IT", {dateStyle:"short", timeStyle:"short", timeZone:"Europe/Rome"}) : "n.d.";
  const fresco = genGiorno === OGGI;
  const stato = fresco
    ? `<p class="sub" style="margin:0 0 8px">Controllo del mattino: dati di oggi, letti da Meta il ${genOra}.</p>`
    : `<div class="act-row" style="grid-template-columns:1fr;border-left-color:var(--crit)">
        <div><div class="what" style="color:var(--crit);font-weight:650">Dati non di oggi: fermi al ${genOra}</div>
        <div class="why">Il giro del mattino non ha aggiornato il cockpit. Le azioni sotto sono quelle di quel giorno e possono mancarne di nuove.</div></div></div>`;
  /* Creative: "attiva" e' lo stato vero su Meta, quindi spuntata e ancora in
     lista vuol dire non spenta. Posizionamenti (22/10/2026): da_staccare vuol dire
     che il targeting dell'ad set acceso lo compra ancora, quindi idem. */
  const vecchie = voci.filter(x => SPUNTE[x.id] && SPUNTE[x.id] < OGGI)
    .map(x => Object.assign({giorno: SPUNTE[x.id]}, x))
    .concat(vecchiePos);  // da_staccare = l'ad set acceso lo compra ancora (targeting letto da Meta)
  const inVerifica = 0;
  const rigaVecchia = x => `<div class="sub" style="margin:4px 0">${esc(nomeCli(x.cli))} · ${
      x.pos ? "posizionamento " + x.pos.map(p => esc(p.nome)).join(", ") : "creativa " + esc(x.creativa.name)
    } · spuntata il ${esc(x.giorno)}, ancora ${x.pos ? "comprato dall'ad set (" + eur(x.pos.reduce((t,p) => t + p.spend, 0)) + " in totale)"
      : "accesa" + (x.daily_budget ? " a " + eur(x.daily_budget) + "/giorno" : "")}</div>`;
  const host = document.getElementById("azioni");
  host.innerHTML = stato + (vive.length ? vive.map(riga).join("")
      : `<div class="empty">Nessuna creativa fuori regola ancora accesa${fresco ? "" : " nei dati di quel giorno"}.</div>`)
    + (nascoste ? `<p class="sub" style="margin-top:6px">${nascoste} ${nascoste === 1 ? "azione spuntata" : "azioni spuntate"} nei giorni scorsi: non compaiono più.${
        inVerifica ? ` ${inVerifica} ${inVerifica === 1 ? "posizionamento si verifica" : "posizionamenti si verificano"} da soli a 7 giorni dalla spunta.` : ""}</p>` : "")
    + (vecchie.length ? `<details style="margin-top:4px"><summary class="sub" style="cursor:pointer;color:var(--serious)">Di queste, ${vecchie.length} ${vecchie.length === 1 ? "risulta ancora accesa" : "risultano ancora accese"} su Meta: la spunta non le ha spente</summary>${vecchie.map(rigaVecchia).join("")}</details>` : "");
  host.querySelectorAll("input[data-az]").forEach(cb =>
    cb.addEventListener("change", () => spunta(cb.dataset.az, cb.checked)));
}
leggiSpunte();

/* ---------- come va ogni cliente ----------
   Semaforo dalle ultime due settimane (giornaliero di Meta, hiring escluso):
   rosso  = creative da staccare ancora accese, 0 lead in 7 giorni con almeno
            la soglia "0 lead" spesa, o CPL 7 gg sopra il tetto di allarme
   giallo = CPL 7 gg sopra il limite di stacco, peggiorato oltre il 30% sulla
            settimana prima, o 5 giorni senza lead
   verde  = il resto. */
const esitiCli = c => {
  const e = c.esiti_creative; if (!e) return null;
  return {apt: e.totale_creative.apt2 + e.senza_creativa.apt2, chiusi: e.totale_creative.chiusi + e.senza_creativa.chiusi};
};
function salute(c){
  const R = DATA.regole, a = c.andamento || {}, u = a.ultimi7 || {}, p = a.prima7 || {};
  const allarme = R.cpl_allarme_pochi_lead_eur || 35, kill = R.cpl_kill_eur || 25;
  const zero = R.spend_kill_zero_lead_eur || 30;
  const m = []; let liv = 0;
  if (c.n_kill_ancora_accese > 0){ liv = 2; m.push(`${c.n_kill_ancora_accese} ${c.n_kill_ancora_accese === 1 ? "creativa da staccare ancora accesa" : "creative da staccare ancora accese"}`); }
  if (!u.lead && (u.spesa || 0) >= zero){ liv = 2; m.push(`0 lead in 7 giorni con ${eur0(u.spesa)} spesi`); }
  else if (u.cpl > allarme){ liv = 2; m.push(`CPL 7 gg sopra ${eur0(allarme)}`); }
  else if (u.cpl > kill){ liv = Math.max(liv, 1); m.push(`CPL 7 gg sopra ${eur0(kill)}`); }
  if (u.cpl && p.cpl && u.cpl > p.cpl * 1.3){ liv = Math.max(liv, 1); m.push(`CPL peggiorato del ${Math.round((u.cpl / p.cpl - 1) * 100)}% sulla settimana prima`); }
  if (a.giorni_da_ultimo_lead >= 5){ liv = Math.max(liv, 1); m.push(`ultimo lead ${a.giorni_da_ultimo_lead} giorni fa`); }
  return {liv, m, u, p, a};
}
function spark(serie, kill){
  if (!serie || !serie.length) return "";
  const W = 300, H = 46, n = serie.length, bw = W / n;
  const maxL = Math.max(1, ...serie.map(x => x.l));
  const cpl = serie.map((x, i) => {
    if (i < 6) return null;
    const w = serie.slice(i - 6, i + 1), s = w.reduce((t, y) => t + y.s, 0), l = w.reduce((t, y) => t + y.l, 0);
    return l ? s / l : null;
  });
  const top = Math.max(kill * 2, ...cpl.filter(v => v != null).map(v => Math.min(v, kill * 3)));
  const y = v => H - 2 - Math.min(v, top) / top * (H - 6);
  let path = "", su = false;
  cpl.forEach((v, i) => { if (v == null){ su = false; return; }
    path += (su ? "L" : "M") + (i * bw + bw / 2).toFixed(1) + " " + y(v).toFixed(1); su = true; });
  return `<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none" aria-label="lead al giorno e CPL a 7 giorni, ultimi 30 giorni">
    ${serie.map((x, i) => x.l ? `<rect x="${(i * bw + 1).toFixed(1)}" y="${(H - x.l / maxL * (H * .55)).toFixed(1)}" width="${(bw - 2).toFixed(1)}" height="${(x.l / maxL * (H * .55)).toFixed(1)}" rx="1" fill="var(--accent)" opacity=".45"><title>${gg(x.g)}: ${x.l} lead, ${eur(x.s)}</title></rect>` : "").join("")}
    <line x1="0" x2="${W}" y1="${y(kill).toFixed(1)}" y2="${y(kill).toFixed(1)}" stroke="var(--muted)" stroke-dasharray="3 3" stroke-width="1" vector-effect="non-scaling-stroke"/>
    <path d="${path}" fill="none" stroke="var(--ink)" stroke-width="1.8" vector-effect="non-scaling-stroke"/></svg>`;
}
