            <td>${chip(k.status)}</td>
            <td class="mono">${eur(k.spend)}</td>
            <td class="mono">${int(k.leads)}</td>
            <td class="mono">${v && v.cpl ? eur(v.cpl) : "—"}${
              k.cpl ? `<div class="k">storico ${eur(k.cpl)}</div>` : ""}</td>
