/* ---------- statiche che portano ----------
   Le creative con almeno un appuntamento (2 APT) o un cliente (CHIUSO) nei
   moduli, in due blocchi: prima quelle che hanno portato clienti, poi quelle
   che hanno portato solo appuntamenti. L'immagine arriva da thumbs.enc (si vede
   sbloccando i nomi) o, nel privato, da thumbs.json. */
function renderStatiche(sel){
  const host = document.getElementById("statiche");
  if (!sel.some(c => c.esiti_creative)){
    host.innerHTML = `<div class="empty">Per questo account non c'è un modulo lead collegato.</div>`; return;
  }
  const r = [];
  const T = {lead:0, apt2:0, chiusi:0, s_apt2:0, s_chiusi:0, spesa:0};
  let letto = null;
  sel.forEach(c => {
    const e = c.esiti_creative; if (!e) return;
    letto = letto || e.letto;
    (e.righe || []).forEach(x => { if (x.apt2 || x.chiusi) r.push({...x, cli: c}); });
    const t = e.totale_creative || {}, z = e.senza_creativa || {};
    T.lead += t.lead || 0; T.apt2 += t.apt2 || 0; T.chiusi += t.chiusi || 0; T.spesa += t.spesa || 0;
    T.s_apt2 += z.apt2 || 0; T.s_chiusi += z.chiusi || 0;
  });
  const apt = T.apt2 + T.s_apt2, cli = T.chiusi + T.s_chiusi;
  const card = x => {
    const img = THUMBS && THUMBS[x.ad_id];
    const costo = x.chiusi && x.costo_cliente ? eur(x.costo_cliente) + " per cliente · " : "";
    return `<div class="st${x.chiusi ? " cli" : ""}">
      <div class="img">${img ? `<img src="${img}" alt="${esc(x.nome)}" loading="lazy">`
        : esc(x.nome) + (DATA.nomi_sbloccabili && !THUMBS ? `<br><span style="font-size:11px">immagine visibile con "Mostra nomi veri"</span>` : "")}</div>
      <div class="tx"><div class="c">${esc(nomeCli(x.cli))}</div>
        <div class="n">${esc(x.nome)}</div>
        <div class="res">
          <div><div class="k">Clienti</div><div class="v mono" style="color:${x.chiusi ? "var(--good)" : "inherit"}">${int(x.chiusi)}</div></div>
          <div><div class="k">Apt</div><div class="v mono">${int(x.apt2)}</div></div>
          <div><div class="k">Lead</div><div class="v mono">${int(x.lead)}</div></div>
        </div>
        <div class="nota">${costo}${x.costo_apt ? eur(x.costo_apt) + " per appuntamento · " : ""}${x.lead ? Math.round(x.apt2 / x.lead * 100) + "% lead → apt · " : ""}${x.attiva ? "accesa"
          : x.copia_accesa ? "accesa in copia (stessa immagine)"
          : "spenta: prima di riaccenderla o duplicarla, controllo ads-bocciate"}</div>
      </div></div>`;
  };
  const rC = r.filter(x => x.chiusi).sort((a, b) => b.chiusi - a.chiusi || b.apt2 - a.apt2 || (a.costo_cliente || 1e9) - (b.costo_cliente || 1e9));
  const rA = r.filter(x => !x.chiusi).sort((a, b) => b.apt2 - a.apt2 || (a.costo_apt || 1e9) - (b.costo_apt || 1e9));
  const blocco = (titolo, righe, vuoto) => `<h3 class="h3">${titolo} <span style="color:var(--muted);font-weight:400">${righe.length}</span></h3>
    ${righe.length ? `<div class="galleria">${righe.map(card).join("")}</div>` : `<div class="empty">${vuoto}</div>`}`;
  host.innerHTML = `<div class="tiles">
      ${tile("Clienti arrivati", int(cli), `${int(T.chiusi)} da creative ads${apt ? " · " + Math.round(cli / apt * 100) + "% degli appuntamenti" : ""}`, cli ? "" : "act")}
      ${tile("Appuntamenti fatti", int(apt), `${int(T.apt2)} da creative ads · ${T.lead ? Math.round(T.apt2 / T.lead * 100) : 0}% di ${int(T.lead)} lead`)}
      ${tile("Costo medio per appuntamento", T.apt2 && T.spesa ? eur(T.spesa / T.apt2) : "n.d.", "spesa delle creative con lead nei moduli ÷ appuntamenti")}
    </div>
    ${blocco("Hanno portato clienti", rC, "Nessuna statica ha ancora portato un cliente chiuso.")}
    ${blocco("Hanno portato appuntamenti", rA, "Nessun'altra statica ha portato appuntamenti.")}
    <p class="sub" style="margin-top:10px">Dai moduli lead${letto ? ", letti il " +
      new Date(letto).toLocaleString("it-IT",{dateStyle:"short",timeStyle:"short"}) : ""}: appuntamento = casella 2 APT,
      cliente = casella CHIUSO, sommati su tutto lo storico. Il costo usa la spesa della creativa nel periodo del cockpit.</p>`;
}

function posLine(c){
  const tutte = (c.posizionamenti || {}).voci || [];
  if (!tutte.length) return "";
  /* sotto i 5 euro nel periodo non dicono niente: una voce sola "altri" */
  const v = tutte.filter(p => p.spend >= 5 || p.da_staccare);
  const resto = tutte.filter(p => !v.includes(p));
  if (resto.length) v.push({nome:`altri ${resto.length}`, reason:resto.map(p => p.nome).join(", "),
    spend:resto.reduce((t,p) => t + p.spend, 0), leads:resto.reduce((t,p) => t + p.leads, 0)});
  const periodo = (c.posizionamenti || {}).periodo || "durata massima";
  return `<div class="pos"><span class="pl">Posizionamenti, ${esc(periodo)}:</span>${v.map(p =>
    `<span class="p ${p.da_staccare ? "kill" : ""}" title="${esc(p.reason)}">${esc(p.nome)} ${eur0(p.spend)} · ${int(p.leads)} lead${
      p.cpl ? " · " + eur0(p.cpl) : ""}${p.da_staccare ? " · stacca" : ""}</span>`).join("")}</div>`;
}

