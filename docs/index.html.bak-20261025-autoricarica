    tile("Lead mancati", int(t.lead_mancati),
         `${eur0(t.spesa)} al CPL target di ${eur0(CPLT)} valgono ${int(t.lead_attesi)} lead, ne sono arrivati ${int(t.lead)}`,
         t.lead_mancati > 0 ? "act" : "")
