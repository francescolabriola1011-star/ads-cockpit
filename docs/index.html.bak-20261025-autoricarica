    tile("CPL creative accese", t.cpl ? eur(t.cpl) : "n/d",
         t.cpl ? `${int(t.creative_accese)} creative accese · ${t.cpl > R.cpl_kill_eur ? "sopra" : "sotto"} il limite di ${eur0(R.cpl_kill_eur)}`
               + (t.cpl > R.cpl_kill_eur && t.cvr >= CVRMIN ? ` · CVR ${t.cvr.toFixed(1)}%: non stacca` : "")
               + (t.cpl_storico ? ` · media storica ${eur(t.cpl_storico)}` : "")
               : (t.cpl_storico ? `nessuna creativa accesa · media storica ${eur(t.cpl_storico)}` : "")),
    tile("CVR click → lead", t.cvr != null ? t.cvr.toFixed(1) + "%" : "n/d",
         t.cvr == null ? "" : (t.cvr < CVRMIN
